<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@android:id/background"
    android:background="@drawable/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">
    <FrameLayout
        android:background="@drawable/widget_logo_tile"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_launcher_foreground"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/widget_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/capture_field"
        android:background="@drawable/widget_field"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/widget_capture_hint"
        android:maxLines="1"
        android:layout_weight="1"
        android:contentDescription="@string/widget_capture_note_description"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"/>
    <ImageButton
        android:id="@+id/capture_task"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_widget_add_task"
        android:scaleType="center"
        android:tint="@color/widget_text"
        android:contentDescription="@string/widget_capture_task_description"/>
    <ImageButton
        android:id="@+id/capture_note"
        android:background="@drawable/widget_accent_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_widget_add"
        android:scaleType="center"
        android:tint="@color/drop_on_accent"
        android:contentDescription="@string/widget_capture_note_description"
        android:layout_marginStart="2dp"/>
</LinearLayout>
