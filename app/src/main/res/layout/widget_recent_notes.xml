<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp">
        <FrameLayout
            android:background="@drawable/widget_logo_tile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_launcher_foreground"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:id="@+id/recent_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_recent_label"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <ImageButton
            android:id="@+id/recent_add"
            android:background="@drawable/widget_accent_circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_widget_add"
            android:scaleType="center"
            android:tint="@color/drop_on_accent"
            android:contentDescription="@string/note_new"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="6dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_row_0"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/note_title_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/note_meta_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_row_1"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/note_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/note_meta_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_row_2"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/note_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/note_meta_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_row_3"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/note_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/note_meta_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_row_4"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/note_title_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/note_meta_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_row_5"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/note_title_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/note_meta_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/widget_text_secondary"
        android:gravity="center"
        android:id="@+id/recent_empty"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/widget_recent_empty"/>
</LinearLayout>
