<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_bg"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp">
        <FrameLayout
            android:background="@drawable/widget_logo_tile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_launcher_foreground"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:id="@+id/tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_tasks_label"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent_content"
            android:gravity="center_vertical"
            android:id="@+id/tasks_view_all"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/widget_view_all_tasks"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <ImageButton
            android:id="@+id/tasks_add"
            android:background="@drawable/widget_accent_circle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_add"
            android:scaleType="center"
            android:tint="@color/drop_on_accent"
            android:contentDescription="@string/task_new"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="-10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_row_0"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <ImageButton
                android:id="@+id/task_check_0"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_checkbox"
                android:scaleType="center"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@string/widget_complete_task_generic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title_0"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_row_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <ImageButton
                android:id="@+id/task_check_1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_checkbox"
                android:scaleType="center"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@string/widget_complete_task_generic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title_1"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_row_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <ImageButton
                android:id="@+id/task_check_2"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_checkbox"
                android:scaleType="center"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@string/widget_complete_task_generic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title_2"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_row_3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <ImageButton
                android:id="@+id/task_check_3"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_checkbox"
                android:scaleType="center"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@string/widget_complete_task_generic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title_3"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_row_4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <ImageButton
                android:id="@+id/task_check_4"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_checkbox"
                android:scaleType="center"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@string/widget_complete_task_generic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title_4"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_row_5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <ImageButton
                android:id="@+id/task_check_5"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_checkbox"
                android:scaleType="center"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@string/widget_complete_task_generic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title_5"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary"
            android:gravity="center"
            android:id="@+id/tasks_empty"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/widget_tasks_empty"/>
    </LinearLayout>
</LinearLayout>
